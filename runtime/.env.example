# .env.example
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Used for Opus escalation audits only (can be same key)
OPUS_API_KEY=sk-ant-...
# Dedicated key for the eval harness (judge/answerer calls). Keeps eval Anthropic spend — and eval prompt
# content — OFF the production proxy key (ANTHROPIC_API_KEY) that forwards paying customers' traffic.
# Falls back to ANTHROPIC_API_KEY if unset (fine for local dev; set a separate key in CI/production).
EVAL_ANTHROPIC_API_KEY=sk-ant-...

# ─── Multi-provider gateway (ADR-0019) ───────────────────────
# Stratum speaks the Anthropic /v1/messages shape to clients but routes each request to a backend by the
# model id (or an explicit provider/ prefix: openai/ , gemini/ , openrouter/ , local/ , anthropic/).
# Configure any subset; a model that routes to an UNCONFIGURED provider returns a clean 400. ANTHROPIC_API_KEY
# (above) already covers Anthropic (claude-* models). Bare names route by heuristic (gpt*→openai, gemini*→
# gemini); anything else uses CQ_DEFAULT_PROVIDER. The same CQ_UPSTREAM_* timeouts apply to every provider.
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1                 # override for an OpenAI-compatible gateway
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=https://your-app.example              # optional OpenRouter HTTP-Referer / X-Title
# OPENROUTER_TITLE=Stratum
GEMINI_API_KEY=...                                          # or GOOGLE_API_KEY
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Local OpenAI-compatible server (Ollama / LM Studio / vLLM / llama.cpp): set the base URL; the key is
# usually a placeholder. Then use a local/<model> id, or set CQ_DEFAULT_PROVIDER=local.
# CQ_LOCAL_BASE_URL=http://localhost:11434/v1
# CQ_LOCAL_API_KEY=ollama
# CQ_DEFAULT_PROVIDER=anthropic                             # provider for bare model names with no heuristic match
# CQ_UPSTREAM_TIMEOUT_MS=120000                             # non-stream total upstream timeout (all providers)
# CQ_UPSTREAM_IDLE_MS=60000                                 # streaming inter-chunk idle timeout (all providers)

# ─── Supabase (local) ────────────────────────────────────────
# `npm run db:start` runs a local Supabase-compatible Compose stack on 127.0.0.1:54321. The retired
# hosted Supabase project is not used (docs/decisions/0020-local-storage-after-hosted-retirement.md).
# Run database commands through `npm run db:with-env -- <command>`: it supplies SUPABASE_URL and a
# short-lived SUPABASE_SERVICE_KEY to that process. Never store the service JWT in this file.
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_KEY=                                     # supplied by `npm run db:with-env`

# ─── Pinecone / Neo4j (optional hosted alternatives, not used) ─
# No current code reads these. Cold memory and the knowledge graph run in the local Postgres stack
# (pgvector, ADR-0013); Pinecone and Neo4j remain swappable seams. Both are third-party hosted
# services that may need a paid account with the vendor, so they are commented out.
# PINECONE_API_KEY=
# PINECONE_INDEX=cq-cold-memory
# PINECONE_ENVIRONMENT=
# NEO4J_URI=
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=

# ─── TEE / AWS Nitro (not used) ──────────────────────────────
# No current code reads these. A Nitro enclave needs a paid AWS host, and a hosted enclave is not part
# of the local-first plan (the project runs on the user's machine), so they are commented out.
# AWS_NITRO_ENCLAVE_CID=
# AWS_NITRO_PCR0=
# AWS_NITRO_PCR1=
# AWS_NITRO_PCR2=

# ─── Audit Model (optional) ──────────────────────────────────
# No current code reads these. A local OpenAI-compatible server (Ollama, LM Studio, vLLM, llama.cpp)
# is the default example; a hosted endpoint (Together AI, Groq) would be billed by that provider.
# AUDIT_MODEL_ENDPOINT=http://localhost:11434/v1/chat/completions
# AUDIT_MODEL_API_KEY=
# AUDIT_MODEL_NAME=

# ─── Encryption ──────────────────────────────────────────────
# 32 random bytes, base64-encoded
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CQ_MASTER_ENCRYPTION_KEY=...

# Dedicated HMAC secret for signing billing records (NEVER reuse the encryption key).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Also REQUIRED in commercial mode to persist each request's usage to billing_records (so a partner
# sees their activity + the invoice has a basis).
CQ_BILLING_SIGNING_SECRET=...

# Optional: override the per-INPUT-token price (USD/token) for ALL models — set to your negotiated
# Anthropic rate. Unset = public list prices (opus 15 / sonnet 3 / haiku 1 per M tokens). VERIFY this
# before billing on savings (pruning-active); until then token_delta is 0 so the fee is $0 regardless.
CQ_INPUT_PRICE_PER_TOKEN=

# ─── Legacy Stripe operator scripts (retained until C3) ─────────
# Use a TEST-mode key (sk_test_...) first; a live key (sk_live_) is refused until verified.
STRIPE_SECRET_KEY=sk_test_...

# ─── CQ Configuration ────────────────────────────────────────
CQ_DEFAULT_LAMBDA=0.97
CQ_DEFAULT_GAIN_SHIFT=0.0
CQ_DEFAULT_THETA=1.0
CQ_ARBITRAGE_RATE=0.20
CQ_AUDIT_CONFIDENCE_THRESHOLD=0.85
CQ_AUDIT_SAMPLE_RATE=0.10

# ─── Server ──────────────────────────────────────────────────
PORT=4080
LOG_LEVEL=info
NODE_ENV=development

# ─── Local network security (specs/security/stratum-local-network.md) ───────
# The proxy is loopback-only by default: it binds 127.0.0.1, and — whenever no auth is configured
# (CQ_COMMERCIAL unset; "personal mode", the default) — it also refuses any request whose Host header
# is missing or isn't a loopback name, and never sends Access-Control-Allow-Origin. Each setting below
# widens that default in one specific way, so each is commented out: widening it is a deliberate choice,
# never the out-of-the-box behavior.

# Canonical bind-host setting. Defaults to 127.0.0.1 (loopback) so personal/local use is private by
# default. A non-loopback address (e.g. bind-all, 0.0.0.0) is refused at startup unless auth is
# configured (CQ_COMMERCIAL with Supabase credentials) or DEVOPS_PROXY_ALLOW_REMOTE_UNAUTHENTICATED
# below is set, and that opt-in only allows the bind. Reaching the proxy from another device by its
# address takes auth; DEVOPS_PROXY_ALLOWED_HOSTS below pins which Host names it then accepts. `HOST` is
# honored for one release as a deprecated alias — used only when DEVOPS_PROXY_HOST is unset or blank —
# and logs a deprecation warning when it is set to a non-empty value, even alongside DEVOPS_PROXY_HOST
# (which then wins).
# DEVOPS_PROXY_HOST=127.0.0.1

# Comma-separated origins allowed to read a cross-origin response (Access-Control-Allow-Origin).
# Consulted only when auth is configured; empty by default, so even an authenticated proxy trusts no
# browser origin until you list one here. An entry `*` means any origin (the response carries
# Access-Control-Allow-Origin: *) and defeats the allow-list, so add it only on purpose. Ignored entirely
# in personal mode, where a cross-origin preflight gets 403 and no response carries
# Access-Control-Allow-Origin, whatever this is set to.
# DEVOPS_PROXY_CORS_ORIGINS=https://your-app.example

# Comma-separated Host-header allow-list. Consulted only when auth is configured; unset means "accept
# any Host" once a key is required. Set it to pin the proxy to the hostname(s) you actually serve it
# under — defends against DNS rebinding even with auth. The loopback names (127.0.0.1, localhost, [::1],
# and DEVOPS_PROXY_HOST when it is itself a loopback address) are always accepted too, with no port or
# with the listening port. An entry with a port (proxy.lan:8443) matches only that host and port; an
# entry without one (proxy.lan) matches that host with no port, or with a port equal to the listening
# port.
# DEVOPS_PROXY_ALLOWED_HOSTS=proxy.lan

# Opt-in (must be the literal "1") to bind a non-loopback address with no auth configured. Refused by
# default, so setting it is an explicit choice, never a config default. It only allows the bind: with no
# auth the proxy still answers 403 to every request whose Host is not a loopback name, so it is not
# reachable from another machine by its address, and that takes auth (CQ_COMMERCIAL with Supabase
# credentials). The Host check reads only the header the client sends, so it is not authentication.
# DEVOPS_PROXY_ALLOW_REMOTE_UNAUTHENTICATED=1

# Opt-in (must be the literal "1") to let a provider base URL (ANTHROPIC_BASE_URL, OPENAI_BASE_URL,
# OPENROUTER_BASE_URL, GEMINI_BASE_URL, CQ_LOCAL_BASE_URL) use plain http to a NON-loopback host.
# Refused by default so a provider key is never sent in the clear over the network; loopback http (a
# local Ollama/LM Studio server) is always allowed with no opt-in required. Does NOT bypass the proxy's
# separate, non-optional refusal to start against a self-loop (a base URL naming its own listen address).
# DEVOPS_PROXY_ALLOW_INSECURE_UPSTREAM=1

# ─── Webhooks ────────────────────────────────────────────────
# Your endpoint to receive CQ webhooks (optional)
WEBHOOK_ENDPOINT=
WEBHOOK_SECRET=
