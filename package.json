{
  "name": "@miltonadina/devops",
  "version": "0.3.0",
  "description": "A self-configuring, verification-first DevOps workflow for AI coding agents. Built for Claude Code; its AGENTS.md contract is tool-agnostic (Codex reads it natively), and no adapters for other tools ship yet.",
  "type": "module",
  "bin": {
    "devops": "./scripts/devops-cli.js",
    "devops-analyze": "./scripts/analyze.sh",
    "devops-install": "./scripts/install.sh"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "analyze": "bash scripts/analyze.sh",
    "install:project": "./scripts/init-project.sh",
    "validate:claims": "npx --yes tsx ./verification/claim-validator.ts",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint:renovate": "node ./scripts/lint-renovate.js",
    "lint:stack-specific-skills": "node ./scripts/lint-stack-specific-skills.js",
    "graph:dashboard": "node scripts/graph-dashboard/server.mjs"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "cursor",
    "antigravity",
    "kiro",
    "devops",
    "spec-driven-development",
    "ears-notation",
    "owasp-asi",
    "skill",
    "agents-md",
    "claude-md",
    "mcp",
    "hooks",
    "subagents",
    "verification",
    "proof-of-work",
    "stratum"
  ],
  "author": "Milton Adina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MILTONADINA/DevOPs.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "tsx": "^4.19.0"
  },
  "files": [
    "AGENTS.md",
    "CLAUDE.md",
    ".claude-plugin/",
    "constitution/",
    "skills/",
    "hooks/",
    "subagents/",
    "slash-commands/",
    "mcp-configs/",
    "modes/",
    "lifecycle/",
    "templates/",
    "memory/",
    "verification/",
    "governance/",
    "meta-memory/",
    "sandbox/",
    "observability/",
    "cost-controls/",
    "analyzer/",
    "scripts/",
    "docs/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ]
}
