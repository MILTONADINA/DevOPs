{
  "name": "@miltonadina/devops",
  "version": "0.5.2",
  "description": "A self-configuring, verification-first DevOps workflow for AI coding agents. Built for Claude Code; its AGENTS.md contract is tool-agnostic (Codex reads it natively), and no adapters for other tools ship yet.",
  "type": "module",
  "bin": {
    "devops": "scripts/devops-cli.js",
    "devops-analyze": "scripts/devops-analyze.js"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "analyze": "bash scripts/analyze.sh",
    "install:project": "./scripts/init-project.sh",
    "validate:claims": "npx --yes tsx ./verification/claim-validator.ts",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint:renovate": "node ./scripts/lint-renovate.js",
    "lint:stack-specific-skills": "node ./scripts/lint-stack-specific-skills.js",
    "graph:dashboard": "node scripts/graph-dashboard/server.mjs"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "cursor",
    "antigravity",
    "kiro",
    "devops",
    "spec-driven-development",
    "ears-notation",
    "owasp-asi",
    "skill",
    "agents-md",
    "claude-md",
    "mcp",
    "hooks",
    "subagents",
    "verification",
    "proof-of-work",
    "stratum"
  ],
  "author": "Milton Adina",
  "license": "MIT",
  "homepage": "https://github.com/MILTONADINA/DevOPs#readme",
  "bugs": {
    "url": "https://github.com/MILTONADINA/DevOPs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MILTONADINA/DevOPs.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "4.23.13",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@agile-graph/engine": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@agile-graph/engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "acorn": "8.18.0",
    "typescript": "5.9.3"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    ".claude-plugin/",
    "analyzer/",
    "constitution/",
    "cost-controls/",
    "hooks/",
    "!hooks/universal/session-start/graph-preflight.sh",
    "lifecycle/",
    "mcp-configs/",
    "memory/README.md",
    "memory/file-based/",
    "meta-memory/",
    "modes/",
    "observability/",
    "sandbox/",
    "skills/",
    "slash-commands/",
    "!slash-commands/universal/graph-halt.md",
    "!slash-commands/universal/graph-resume.md",
    "!slash-commands/universal/sprint.md",
    "!slash-commands/universal/sprint-approve.md",
    "subagents/",
