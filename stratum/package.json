{
  "name": "startum",
  "version": "0.1.0",
  "description": "High-fidelity AI context pruning middleware — eliminate the Context Tax",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx src/proxy/index.ts",
    "build": "tsc --noEmit -p tsconfig.typecheck.json",
    "build:vercel": "npx esbuild vercel-src/entry.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=api/index.js",
    "build:wasm": "cd rust/hot-path && wasm-pack build --target nodejs",
    "start": "node dist/proxy/index.js",
    "lint": "eslint src --ext .ts && prettier --check src",
    "lint:fix": "eslint src --ext .ts --fix && prettier --write src",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:eval": "tsx evals/harness/runner.ts",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:eval",
    "capture": "tsx scripts/capture-session.ts",
    "import-sessions": "tsx scripts/import-sessions.ts",
    "analyze-waste": "tsx scripts/analyze-waste.ts",
    "verify-encoder": "tsx scripts/verify-encoder.ts",
    "verify-tier2": "tsx scripts/verify-tier2.ts",
    "eval:dev": "tsx scripts/eval-dev.ts",
    "eval:tierc": "tsx scripts/eval-tierc.ts",
    "eval:tierb": "tsx scripts/eval-tierb.ts",
    "eval:locomo": "tsx scripts/eval-locomo.ts",
    "eval:locomo:survival": "tsx scripts/eval-locomo-survival.ts",
    "eval:longmemeval": "tsx scripts/eval-longmemeval.ts",
    "eval:longmemeval:survival": "tsx scripts/eval-longmemeval-survival.ts",
    "shadow-prune": "tsx scripts/shadow-prune.ts",
    "sweep-params": "tsx scripts/sweep-params.ts",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "smoke:judge": "tsx scripts/smoke-judge.ts",
    "smoke:memory": "tsx scripts/smoke-memory.ts",
    "bench:tiers": "tsx scripts/bench-tiers.ts",
    "promote": "tsx scripts/promote-tier2-to-tier3.ts",
    "promote:schedule": "tsx scripts/local-promotion-schedule.ts",
    "understand-codebase": "tsx scripts/understand-codebase.ts",
    "understand-codebase:bound": "tsx scripts/understand-codebase-bound.ts",
    "audit:repo": "tsx scripts/audit-repo.ts",
    "bench:audit-indexer": "tsx scripts/bench-audit-indexer.ts",
    "audit:conflicts": "tsx scripts/audit-conflicts.ts",
    "backup": "tsx scripts/backup-org.ts",
    "restore": "tsx scripts/restore-org.ts",
    "invoice": "tsx scripts/invoice.ts",
    "verify-billing": "tsx scripts/verify-billing.ts",
    "verify-stripe": "tsx scripts/verify-stripe.ts",
    "create-org": "tsx scripts/create-org.ts",
    "create-api-key": "tsx scripts/create-api-key.ts",
    "api-keys": "tsx scripts/api-keys.ts",
    "db:start": "tsx scripts/local-compose.ts start",
    "db:stop": "tsx scripts/local-compose.ts stop",
    "db:migrate": "tsx scripts/local-compose.ts migrate",
    "db:with-env": "tsx scripts/local-compose.ts with-env",
    "db:verify": "tsx scripts/local-compose.ts with-env node test/integration/local-compose-api.mjs",
    "db:verify-recall": "tsx scripts/local-compose.ts with-env node test/integration/local-session-start.mjs",
    "db:verify-promotion": "tsx scripts/local-compose.ts with-env node test/integration/local-promotion.mjs",
    "db:verify-audit-git": "tsx scripts/local-compose.ts with-env node test/integration/local-audit-git.mjs",
    "db:verify-recovery": "tsx scripts/local-compose.ts with-env node test/integration/local-backup-recovery.mjs",
    "db:verify-proxy-memory": "tsx scripts/local-compose.ts with-env tsx test/integration/local-proxy-memory.ts",
    "db:verify-message-memory": "tsx scripts/local-compose.ts with-env tsx test/integration/local-message-memory.ts",
    "db:verify-message-audit": "tsx scripts/local-compose.ts with-env tsx test/integration/local-message-audit.ts",
    "db:verify-request-survival": "tsx scripts/local-compose.ts with-env tsx test/integration/local-request-survival.ts",
    "db:verify-real-model-memory": "tsx scripts/local-compose.ts with-env tsx test/integration/local-real-model-memory.ts",
    "db:verify-graph-read": "tsx scripts/local-compose.ts with-env tsx test/integration/local-graph-read.ts",
    "db:verify-graph-integrity": "tsx scripts/local-compose.ts with-env tsx test/integration/local-graph-org-integrity.ts",
    "db:verify-graph-search": "tsx scripts/local-compose.ts with-env tsx test/integration/local-graph-search.ts",
    "db:verify-graph-semantic": "tsx scripts/local-compose.ts with-env tsx test/integration/local-graph-semantic.ts",
    "db:verify-graph-related-facts": "tsx scripts/local-compose.ts with-env tsx test/integration/local-graph-related-facts.ts",
    "db:verify-source-fact-backfill": "tsx test/integration/local-source-fact-backfill.ts",
    "verify:graph-browser": "tsx test/integration/browser-graph.ts",
    "db:verify-source-graph": "tsx scripts/local-compose.ts with-env tsx test/integration/local-source-graph.ts",
    "ingest-source-graph": "tsx scripts/ingest-source-graph.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@pinecone-database/pinecone": "^3.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.3",
    "fastify-plugin": "^4.5.1",
    "neo4j-driver": "^5.17.0",
    "onnxruntime-node": "^1.17.3",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "uuid": "^11.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@types/node": "^22.20.4",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "supabase": "^2.117.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  }
}
