{
  "name": "startum",
  "version": "0.1.0",
  "description": "High-fidelity AI context pruning middleware — eliminate the Context Tax",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ts-node src/proxy/index.ts",
    "build": "tsc --noEmit -p tsconfig.typecheck.json",
    "build:wasm": "cd rust/hot-path && wasm-pack build --target nodejs",
    "start": "node dist/proxy/index.js",
    "lint": "eslint src --ext .ts && prettier --check src",
    "lint:fix": "eslint src --ext .ts --fix && prettier --write src",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:eval": "ts-node evals/harness/runner.ts",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:eval",
    "capture": "ts-node scripts/capture-session.ts",
    "promote": "ts-node scripts/promote-tier2-to-tier3.ts",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:push": "npx supabase db push",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@pinecone-database/pinecone": "^3.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.3",
    "fastify-plugin": "^4.5.1",
    "neo4j-driver": "^5.17.0",
    "onnxruntime-node": "^1.17.3",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "uuid": "^11.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260528.1",
    "@types/node": "^20.11.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "supabase": "^1.145.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.50.0"
  }
}
