api/index.js
.vercel/
vercel-src/local-test.mjs

# Dependencies
node_modules/

# TypeScript
*.tsbuildinfo

# Rust / WASM
rust/*/target/
rust/*/pkg/

# Supabase local
.branches/
supabase/.temp/
supabase/docker-compose.yml

# Eval results (too large to commit)
evals/results/

# Tier-A external benchmark datasets (licensed / large; fetched on demand, NOT
# committed — see ADR-0014). The synthetic Tier-B jsonl IS committed (it's ours).
evals/datasets/locomo/
evals/datasets/mtbench/
evals/datasets/scm4llms/
evals/datasets/longmemeval/

# ONNX model cache (fetched on demand; not committed — see ADR-0010)
models/
.cache/

# Raw captured sessions (may contain sensitive content)
data/sessions/
data/design-partner/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
*.swp

